# .dev.vars dosyasına kopyalayın. Gerçek anahtarları asla Git'e eklemeyin.
OPENROUTER_API_KEY=
# Open WebUI, değerlendirme ve yönetim istekleri için gerekli. Üretmek için: openssl rand -hex 32
RAGNA_API_KEY=
# İsteğe bağlı. Yalnızca MODEL_ROUTE=local-first olduğunda kullanılır.
OLLAMA_BASE_URL=http://localhost:11434
# Herkese açık demo için isteğe bağlı koruma. Eşleşen public site key değerini Wrangler vars alanına ekleyin.
TURNSTILE_SECRET_KEY=
