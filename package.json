{
  "name": "ragna",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An evidence-first RAG workbench with reproducible evaluations and resilient cloud inference.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm:dev:api' 'npm:dev:web'",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm test && npm run evaluate",
    "data:generate": "node --import tsx scripts/generate-data.ts",
    "db:local": "wrangler d1 migrations apply ragna --local",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "evaluate:live": "node --import tsx scripts/evaluate-live.ts",
    "synthetic": "node --import tsx scripts/synthetic.ts",
    "cloud:provision": "node --import tsx scripts/provision.ts",
    "cloud:index": "node --import tsx scripts/index-cloud.ts",
    "deploy": "npm run build && wrangler deploy --config wrangler.production.json",
    "preview": "wrangler dev --port 8787",
    "test:smoke": "node --import tsx scripts/smoke.ts",
    "secrets:init": "node --import tsx scripts/secrets.ts",
    "secrets:deploy": "node --import tsx scripts/secrets.ts --deploy",
    "evaluate:retrieval": "node --import tsx scripts/evaluate-retrieval.ts",
    "webui": "docker compose --env-file .dev.vars up -d",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cache:warm": "node --import tsx scripts/warm-cache.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "hono": "^4.7.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.1.0",
    "prettier": "3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.146.0"
  }
}
